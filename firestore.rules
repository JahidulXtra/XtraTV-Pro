rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Channel data — admin panel add/edit/delete writes here.
    // Only signed-in admins (Firebase Auth) can write.
    match /channels_chunks/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /channels_metadata/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /deleted_presets/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /featured_channels_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Analytics hits — anyone can log a new hit (anonymous visitor
    // tracking), but only signed-in admins can view or clear the log.
    match /analytics_hits/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['id','timestamp','dateStr','year','month','day','deviceType','country','countryCode','userAgent']) &&
        request.resource.data.deviceType in ['desktop','mobile','app'] &&
        request.resource.data.country is string && request.resource.data.country.size() < 100 &&
        request.resource.data.countryCode is string && request.resource.data.countryCode.size() <= 5 &&
        request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // Channel-watch hits — anyone can log a new "channel selected" event
    // (anonymous viewer tracking, used for the Most-Watched Channels
    // report), but only signed-in admins can view or clear the log.
    match /channel_hits/{docId} {
      allow create: if
        request.resource.data.keys().hasAll(['id','channelId','channelName','timestamp','dateStr','year','month','deviceType']) &&
        request.resource.data.channelId is string && request.resource.data.channelId.size() < 200 &&
        request.resource.data.channelName is string && request.resource.data.channelName.size() < 200 &&
        request.resource.data.deviceType in ['desktop','mobile','app'];
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // Admin roster / roles (owner, editor, viewer) — doc id is the admin's
    // Firebase Auth uid. This is an organizational/soft-permission layer
    // enforced by the app UI, not a hard security boundary: any signed-in
    // admin already has write access to the collections above, same as
    // before this feature existed. Locking role writes down further would
    // require server-side custom claims (Cloud Functions), which this
    // static-hosted app does not use.
    match /admin_roles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Connectivity check document used on app startup
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is blocked by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
